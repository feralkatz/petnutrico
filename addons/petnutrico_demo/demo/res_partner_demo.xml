<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!--
            OJO: "credit_limit" solo tiene efecto de advertencia si, además
            de fijar este campo, activas el ajuste "Límite de Crédito de
            Ventas" en Contabilidad → Configuración → Ajustes → Facturas de
            Clientes. Ese ajuste es a nivel de empresa y no se puede activar
            desde datos XML de forma confiable (es un campo de
            res.config.settings, no de res.company directamente en todas
            las versiones) — actívalo manualmente después de instalar.
        -->
        <record id="partner_mayorista_ejemplo" model="res.partner">
            <field name="name">Distribuidora Mascotas Felices</field>
            <field name="company_type">company</field>
            <field name="is_company">True</field>
            <field name="customer_rank">1</field>
            <field name="country_id" ref="base.mx"/>
            <field name="property_payment_term_id" ref="account.account_payment_term_30days"/>
            <field name="credit_limit">135000</field>
        </record>

    </data>
</odoo>
