<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        noupdate="0": se fuerza en cada instalación/actualización del módulo,
        así no importa qué país haya quedado configurado en el asistente de
        creación de la base de Odoo Online.
    -->
    <record id="base.main_company" model="res.company">
        <field name="name">PetNutriCo</field>
        <field name="country_id" ref="base.mx"/>
        <field name="currency_id" ref="base.MXN"/>
        <field name="city">Puebla</field>
        <field name="state_id" ref="base.state_mx_pue"/>
    </record>

    <record id="base.partner_main_company" model="res.partner">
        <field name="name">PetNutriCo</field>
        <field name="country_id" ref="base.mx"/>
        <field name="city">Puebla</field>
        <field name="state_id" ref="base.state_mx_pue"/>
    </record>
</odoo>
